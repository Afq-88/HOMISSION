{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "src/**", "tools/**", "node_modules/**", "*.zip", "FIREBASE.txt"],
    "cleanUrls": false,
    "headers": [
      {"source": "assets/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}

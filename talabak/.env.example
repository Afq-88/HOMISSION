# متغيرات التشغيل (كلها اختيارية)
PORT=3000
DATA_DIR=./data            # مكان قاعدة البيانات والنسخ الاحتياطية — يجب أن يكون على قرص دائم
TRUST_PROXY=1              # خلف وسيط HTTPS (Render/Railway/Nginx/Cloudflare)
COOKIE_SECURE=1            # عند التشغيل المباشر على HTTPS
BACKUP_EVERY_HOURS=6       # 0 لإيقاف النسخ التلقائي
BACKUP_KEEP=40             # عدد النسخ المحتفظ بها
